# Copier ce fichier en .env puis renseigner : cp .env.example .env
# Le fichier .env ne doit JAMAIS être versionné (il est dans .gitignore).

# Signature des cookies — openssl rand -hex 32
# Vide : une clé est générée au premier démarrage et gardée dans le volume (data/secret.key).
# Elle chiffre aussi les secrets de double authentification : la changer impose de réinitialiser la 2FA des comptes.
SECRET_KEY=

# --- Compte administrateur créé au PREMIER démarrage (ignoré ensuite) ---
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi-svp
# Double authentification (code à 6 chiffres) imposée au compte administrateur créé au premier démarrage :
# QR code à scanner dès la première connexion. Ensuite : menu du compte (Mon compte / Comptes d'accès).
ADMIN_REQUIRE_2FA=0

# 1 derrière Nginx Proxy Manager : vraie IP client (logs + anti-bruteforce)
TRUST_PROXY=1
# 1 si l'application est servie uniquement en HTTPS
COOKIE_SECURE=0
# Durée d'une session (heures), prolongée à chaque visite — 720 = 30 jours (pratique sur iPhone en écran d'accueil)
SESSION_HOURS=720

# Double authentification : « se souvenir de cet appareil » pendant N jours (0 = désactivé)
TRUST_DAYS=30

# Fuseau horaire (découpage « Hier / Aujourd'hui »)
TZ=Europe/Paris

# --- Collecte des flux ---
# Intervalle entre deux collectes, en minutes (5 à 1440)
FETCH_INTERVAL=30
# Nombre de flux téléchargés en parallèle
FETCH_CONCURRENCY=6
# Durée de conservation des articles, en jours
RETENTION_DAYS=30

# --- Sauvegardes ---
# Copie quotidienne de la base dans data/backups/AAAA-MM-JJ/ : nombre de jours conservés
BACKUP_DAYS=30

# --- Flux (chaque compte gère les siens) ---
# Nombre maximum de flux par compte
MAX_FEEDS_PER_USER=300
# 1 : autorise les flux hébergés sur le réseau local (192.168.x, 10.x, 127.0.0.1…).
# 0 par défaut : un compte ne peut pas faire interroger par le serveur une adresse interne.
ALLOW_PRIVATE_FEEDS=0
